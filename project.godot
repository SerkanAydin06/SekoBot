config_version=5

[application]

config/name="SekoBot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=900
window/size/viewport_height=580
window/size/window_width_override=900
window/size/window_height_override=580
window/size/mode=0
window/size/initial_position_type=1
window/size/borderless=true
window/size/resizable=false
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0392, 0.0588, 0.102, 1)
